+    expect(prompts).toBe(0)
+    dispose()
+  })
+
+  it('keeps a running subagent on its official Queue-only continuation mode', async () => {
+    const promptCalls: unknown[][] = []
+    const session = submissionSessionFixture({
+      running: true,
+      subagent: true,
+      prompt: async (...args: unknown[]) => {
+        promptCalls.push(args)
+        return { ok: true, value: { accepted: true } }
+      },
+    })
+    const sessions = submissionSessionsFixture(session)
+    const policyCalls: unknown[][] = []
+    const dispose = installNativeConversationProjection(sessions, (running, gesture, steeringAvailable) => {
+      policyCalls.push([running, gesture, steeringAvailable])
+      return steeringAvailable ? 'steer' : 'queue'
+    })
+
+    const result = await globalThis.__DSH_NATIVE_CONVERSATION_PROJECTION__?.submit(
+      'continue child',
+      'accelerated',
+    )
+
+    expect(result).toEqual({ accepted: true, action: 'prompt', mode: 'queue' })
+    expect(policyCalls).toEqual([[true, 'accelerated', false]])
+    expect(promptCalls).toEqual([[[{ type: 'text', text: 'continue child' }], 'queue']])
+    dispose()
+  })
+})
+
+function queuedMessage(id: string): ConversationSnapshot['queue'][number] {
+  return {
+    id: MessageId(id),
+    messageId: MessageId(id),
+    placement: 'queued',
+    content: [{ type: 'text', text: id }],
+    preview: id,
+    text: id,
+  }
+}
+
+function submissionSessionFixture(options: {
+  running: boolean
+  subagent?: boolean
+  queue?: ConversationSnapshot['queue']
+  prompt?: (...args: unknown[]) => Promise<unknown>
+  updateQueue?: (id: string) => Promise<unknown>
+}): SessionFace {
+  const snapshot = {
+    ...conversationFixture('session-submit', 'existing'),
+    running: options.running,
+    queue: options.queue ?? [],
+    subagent: options.subagent === true
+      ? {
+          address: {
+            parentSessionId: 'parent', childSessionId: 'session-submit', mode: 'continuable',
+          },
+          parentAvailable: true,
+        }
+      : null,
+  }
+  return {
+    getSnapshot: () => snapshot,
+    subscribe: () => () => {},
+    prompt: options.prompt ?? (async () => ({ ok: true, value: { accepted: true } })),
+    updateQueue: options.updateQueue ?? (async () => ({ ok: true, value: { accepted: true } })),
+  } as unknown as SessionFace
+}
+
+function submissionSessionsFixture(session: SessionFace): ISessions {
