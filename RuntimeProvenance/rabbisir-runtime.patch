+/** Session-authorized Markdown file workbench for the right details panel. */
+import { useEffect, useLayoutEffect, useRef, useState } from 'react'
+import type { MouseEvent as ReactMouseEvent } from 'react'
+import type { MarkdownPreviewDocument, RpcResult } from '@deepseek-ai/dsh-api-remotes/client'
+import { MarkdownText } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { PropsLocale } from '@deepseek-ai/dsh-client-ui-slots'
+import type { NS } from '../locales.ts'
+import css from './MarkdownWorkbench.module.css'
+
+type Mode = 'preview' | 'source' | 'plain' | 'word' | 'pdf'
+type Paper = 'a4'
+type Orientation = 'portrait'
+
+function displayName(path: string): string {
+  return path.replaceAll('\\', '/').split('/').filter(Boolean).at(-1) ?? path
+}
+
+function safeErrorMessage(message: string, path: string): string {
+  const name = displayName(path)
+  return message.replaceAll(path, name)
+    .replace(/(?:[A-Za-z]:\\|\/(?:Users|home|private|tmp)\/)[^\n:]+/g, name)
+}
+
+function PlainTextProjection({ text, onChange }: { text: string; onChange: (value: string) => void }) {
+  const ref = useRef<HTMLDivElement>(null)
+  useLayoutEffect(() => {
+    const rendered = ref.current
+    if (rendered === null) return
+    const value = (rendered.innerText || rendered.textContent || '').replace(/\n{3,}/g, '\n\n').trim()
+    onChange(value)
+  }, [onChange, text])
+  return <div ref={ref} className={css.plainMeasure} aria-hidden><MarkdownText text={text} /></div>
+}
+
+const PAGE_HEIGHT: Record<Paper, Record<Orientation, number>> = {
+  a4: { portrait: 1123 },
+}
+
+type WordSnapshot = { source: string; pages: string[] }
+
+function wordStorageKey(path: string): string {
+  let hash = 2166136261
+  for (const character of path) hash = Math.imul(hash ^ character.charCodeAt(0), 16777619)
+  return `rabbisir:document-layout:${(hash >>> 0).toString(36)}`
+}
+
+function legacyWordStorageKey(path: string): string {
+  let hash = 2166136261
+  for (const character of path) hash = Math.imul(hash ^ character.charCodeAt(0), 16777619)
+  // Compatibility-only read key for layouts saved by the pre-Rabbisir workbench.
+  return `dsh-es:word:${(hash >>> 0).toString(36)}`
+}
+
+function sanitizeWordHtml(html: string): string {
+  const template = window.document.createElement('template')
+  template.innerHTML = html
+  const allowed = new Set(['A', 'B', 'BLOCKQUOTE', 'BR', 'CODE', 'DEL', 'DIV', 'EM', 'FONT', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6', 'HR', 'I', 'IMG', 'LI', 'OL', 'P', 'PRE', 'SPAN', 'STRONG', 'TABLE', 'TBODY', 'TD', 'TH', 'THEAD', 'TR', 'U', 'UL'])
+  const styleNames = new Set(['color', 'font-size', 'font-weight', 'font-style', 'text-decoration', 'text-align', 'line-height', 'letter-spacing'])
+  for (const element of Array.from(template.content.querySelectorAll('*'))) {
+    if (!allowed.has(element.tagName)) {
+      element.replaceWith(...Array.from(element.childNodes))
+      continue
+    }
+    for (const attribute of Array.from(element.attributes)) {
+      if (attribute.name === 'style') continue
+      if (element.tagName === 'A' && attribute.name === 'href' && /^https?:\/\//i.test(attribute.value)) continue
+      if (element.tagName === 'IMG' && ['src', 'alt'].includes(attribute.name) && (attribute.name === 'alt' || /^(?:https?:|data:image\/)/i.test(attribute.value))) continue
+      element.removeAttribute(attribute.name)
+    }
+    const kept: string[] = []
+    for (const name of styleNames) {
+      const value = (element as HTMLElement).style.getPropertyValue(name)
+      if (/^[#(),.%\w\s-]+$/.test(value)) kept.push(`${name}:${value}`)
+    }
+    element.removeAttribute('style')
+    if (kept.length > 0) element.setAttribute('style', kept.join(';'))
+  }
+  return template.innerHTML
+}
+
+function inlineMarkdown(node: Node): string {
+  if (node.nodeType === Node.TEXT_NODE) return node.textContent ?? ''
+  if (!(node instanceof HTMLElement)) return ''
+  const text = Array.from(node.childNodes).map(inlineMarkdown).join('')
+  if (node.matches('strong,b')) return `**${text}**`
+  if (node.matches('em,i')) return `*${text}*`
+  if (node.matches('del')) return `~~${text}~~`
+  if (node.matches('code') && node.parentElement?.tagName !== 'PRE') return `\`${text}\``
+  if (node.matches('a')) return `[${text}](${node.getAttribute('href') ?? ''})`
+  if (node.matches('br')) return '\n'
+  return text
+}
+
+function blockMarkdown(element: Element): string {
+  const tag = element.tagName.toLowerCase()
+  if (/^h[1-6]$/.test(tag)) return `${'#'.repeat(Number(tag[1]))} ${inlineMarkdown(element)}`
+  if (tag === 'p') return inlineMarkdown(element)
+  if (tag === 'pre') {
+    const code = element.querySelector('code')
+    return `\`\`\`\n${code === null ? element.textContent : code.textContent}\n\`\`\``
+  }
+  if (tag === 'blockquote') return inlineMarkdown(element).split('\n').map(line => `> ${line}`).join('\n')
+  if (tag === 'ul' || tag === 'ol') return Array.from(element.children).map((child, index) => `${tag === 'ol' ? `${index + 1}.` : '-'} ${inlineMarkdown(child)}`).join('\n')
+  const nestedTable = element.querySelector(':scope > table')
+  const table = tag === 'table' ? element : nestedTable
+  if (table !== null) {
+    const rows = Array.from(table.querySelectorAll('tr')).map(row => Array.from(row.querySelectorAll('th,td')).map(cell => inlineMarkdown(cell)))
+    const [header, ...body] = rows
+    if (header === undefined) return ''
+    return [header, header.map(() => '---'), ...body].map(row => `| ${row.join(' | ')} |`).join('\n')
+  }
+  if (tag === 'hr') return '---'
+  return Array.from(element.children).map(blockMarkdown).filter(Boolean).join('\n\n') || inlineMarkdown(element)
+}
+
+function pagesMarkdown(hosts: Array<HTMLDivElement | null>): string {
+  return hosts.flatMap(host => host === null ? [] : Array.from(host.children).map(blockMarkdown)).filter(Boolean).join('\n\n')
+}
+
+/** Paginate sanitized Markdown blocks into fixed paper boxes. */
+function PaginatedMarkdown({ text, paper, orientation, editable = false, snapshot, onEdit }: {
+  text: string
+  paper: Paper
+  orientation: Orientation
+  editable?: boolean
+  snapshot?: WordSnapshot | null
+  onEdit?: (markdown: string, pages: string[]) => void
+}) {
+  const measureRef = useRef<HTMLDivElement>(null)
+  const pageRefs = useRef<Array<HTMLDivElement | null>>([])
+  const groupsRef = useRef<Element[][]>([])
+  const [layoutRevision, setLayoutRevision] = useState(0)
+
+  useLayoutEffect(() => {
+    const source = measureRef.current?.firstElementChild
+    if (source === null || source === undefined) return
+    const padding = 112
+    const capacity = PAGE_HEIGHT[paper][orientation] - padding
+    const groups: Element[][] = []
+    let current: Element[] = []
+    let used = 0
+    for (const child of Array.from(source.children)) {
+      const style = getComputedStyle(child)
+      const height = child.getBoundingClientRect().height
+        + Number.parseFloat(style.marginTop || '0') + Number.parseFloat(style.marginBottom || '0')
+      if (current.length > 0 && used + height > capacity) {
+        groups.push(current)
+        current = []
+        used = 0
+      }
+      current.push(child)
+      used += height
+    }
+    if (current.length > 0 || groups.length === 0) groups.push(current)
+    groupsRef.current = groups
+    setLayoutRevision(value => value + 1)
+  }, [orientation, paper, text])
+
+  useLayoutEffect(() => {
+    pageRefs.current.forEach((host, index) => {
+      if (host === null) return
+      host.replaceChildren(...(groupsRef.current[index] ?? []).map(node => node.cloneNode(true)))
+      const saved = snapshot?.source === text ? snapshot.pages[index] : undefined
+      if (saved !== undefined) host.innerHTML = sanitizeWordHtml(saved)
+    })
+  }, [layoutRevision, snapshot, text])
+
+  const capture = (): void => {
+    if (!editable || onEdit === undefined) return
+    const pages = pageRefs.current.map(host => sanitizeWordHtml(host?.innerHTML ?? ''))
+    onEdit(pagesMarkdown(pageRefs.current), pages)
+  }
+
+  return <div className={css.pages} data-page-count={groupsRef.current.length || 1}>
+    <div
+      ref={measureRef} className={`${css.measure} ${css.page}`} aria-hidden
+      data-paper={paper} data-orientation={orientation}
+    >
+      <MarkdownText text={text} />
+    </div>
+    {Array.from({ length: groupsRef.current.length || 1 }, (_, index) => <article
+      key={`${layoutRevision}:${index}`} className={css.page} data-paper={paper} data-orientation={orientation}
+      aria-label={`${index + 1} / ${groupsRef.current.length || 1}`}
+    >
+      <div
+        ref={(element) => { pageRefs.current[index] = element }} className={css.pageContent}
+        contentEditable={editable || undefined} suppressContentEditableWarning
+        role={editable ? 'textbox' : undefined} aria-multiline={editable || undefined}
+        onBlur={capture}
+      />
+      <span className={css.pageNumber} aria-hidden>{index + 1}</span>
+    </article>)}
+  </div>
+}
+
+/* oxlint-disable typescript/no-deprecated -- Browser editing history and formatting commands preserve native selection semantics. */
+function WordToolbar() {
+  const [state, setState] = useState({
+    bold: false, italic: false, underline: false, align: 'left', block: 'p', size: '3',
+    color: '#17191c', lineHeight: '1.7', letterSpacing: '0',
+  })
+  const range = useRef<Range | null>(null)
+  useEffect(() => {
+    const update = (): void => {
+      const node = window.getSelection()?.anchorNode
+      if (!(node instanceof Node) || node.parentElement?.closest('[data-word-layout]') === null) return
+      const selection = window.getSelection()
+      if (selection !== null && selection.rangeCount > 0) range.current = selection.getRangeAt(0).cloneRange()
+      const align = ['center', 'right', 'full'].find(value => document.queryCommandState(`justify${value}`)) ?? 'left'
+      const block = node.parentElement?.closest('p,h1,h2,h3,li,td,th') as HTMLElement | null
+      const computed = block === null ? null : getComputedStyle(block)
+      const fontColor = document.queryCommandValue('foreColor')
+      setState({
+        bold: document.queryCommandState('bold'), italic: document.queryCommandState('italic'), underline: document.queryCommandState('underline'), align,
+        block: block?.tagName.toLowerCase().replace(/^(?:li|td|th)$/, 'p') ?? 'p',
+        size: document.queryCommandValue('fontSize') || '3',
+        color: /^#[0-9a-f]{6}$/i.test(fontColor) ? fontColor : '#17191c',
+        lineHeight: computed?.lineHeight === 'normal' ? '1.7' : block?.style.lineHeight || '1.7',
+        letterSpacing: block?.style.letterSpacing.replace(/em$/, '') || '0',
+      })
+    }
+    document.addEventListener('selectionchange', update)
+    return () => { document.removeEventListener('selectionchange', update) }
+  }, [])
+  const command = (name: string, value?: string): void => {
+    if (range.current !== null) {
+      const selection = window.getSelection()
+      selection?.removeAllRanges()
+      selection?.addRange(range.current)
+    }
+    document.execCommand(name, false, value)
+    document.getSelection()?.anchorNode?.parentElement?.closest('[contenteditable]')?.dispatchEvent(new InputEvent('input', { bubbles: true }))
+  }
+  const keepSelection = (event: ReactMouseEvent): void => { event.preventDefault() }
+  return <div className={css.wordToolbar} role="toolbar" aria-label="Word 编辑工具栏">
+    <button type="button" title="撤销" onMouseDown={keepSelection} onClick={() => { command('undo') }}>↶</button>
+    <button type="button" title="重做" onMouseDown={keepSelection} onClick={() => { command('redo') }}>↷</button>
+    <select title="标题与正文样式" value={state.block} onChange={(event) => { command('formatBlock', event.currentTarget.value) }}>
+      <option value="p">正文</option><option value="h1">标题 1</option><option value="h2">标题 2</option><option value="h3">标题 3</option>
+    </select>
+    <select title="字号" value={state.size} onChange={(event) => { command('fontSize', event.currentTarget.value) }}>
+      <option value="2">小</option><option value="3">常规</option><option value="4">大</option><option value="5">特大</option>
+    </select>
+    <label title="文字颜色" className={css.colorControl}>A<input type="color" value={state.color} onChange={(event) => { command('foreColor', event.currentTarget.value) }} /></label>
+    {([['bold', 'B', state.bold], ['italic', 'I', state.italic], ['underline', 'U', state.underline]] as const).map(([name, label, active]) => <button
+      key={name} type="button" title={name} aria-pressed={active} onMouseDown={keepSelection} onClick={() => { command(name) }}
+    >{label}</button>)}
+    {([['justifyleft', '左对齐', 'left'], ['justifycenter', '居中', 'center'], ['justifyright', '右对齐', 'right'], ['justifyfull', '两端对齐', 'full']] as const).map(([name, label, align]) => <button
+      key={name} type="button" title={label} aria-label={label} aria-pressed={state.align === align} onMouseDown={keepSelection} onClick={() => { command(name) }}
+    >{align === 'left' ? '≡' : align === 'center' ? '≣' : align === 'right' ? '≡' : '☰'}</button>)}
+    <select title="行间距" value={state.lineHeight} onChange={(event) => { const block = window.getSelection()?.anchorNode?.parentElement?.closest('p,h1,h2,h3,li,td,th') as HTMLElement | null; if (block !== null) { block.style.lineHeight = event.currentTarget.value; block.dispatchEvent(new InputEvent('input', { bubbles: true })) } }}>
+      <option value="1.2">1.2</option><option value="1.5">1.5</option><option value="1.7">1.7</option><option value="2">2.0</option>
+    </select>
+    <select title="字间距" value={state.letterSpacing} onChange={(event) => { const block = window.getSelection()?.anchorNode?.parentElement?.closest('p,h1,h2,h3,li,td,th') as HTMLElement | null; if (block !== null) { block.style.letterSpacing = `${event.currentTarget.value}em`; block.dispatchEvent(new InputEvent('input', { bubbles: true })) } }}>
+      <option value="0">默认字距</option><option value="0.03">宽 0.03</option><option value="0.08">宽 0.08</option>
+    </select>
+  </div>
+}
+/* oxlint-enable typescript/no-deprecated */
+
+/** Props keep file IO and the explicit native handoff outside presentation. */
+export interface MarkdownWorkbenchProps extends PropsLocale<typeof NS> {
+  path: string
+  load: (path: string, signal?: AbortSignal) => Promise<RpcResult<{ document: MarkdownPreviewDocument }>>
+  save?: (
+    path: string, content: string, expectedModifiedAt: number, signal?: AbortSignal,
+  ) => Promise<RpcResult<{ document: MarkdownPreviewDocument }>>
+  openExternal: (path: string) => void
+  onMetadata?: (metadata: { bytes: number; modifiedAt: number } | null) => void
+}
+
+/** Right-panel Markdown preview/source/print-preview workspace. */
+export function MarkdownWorkbench({ path, load, save, openExternal, onMetadata, t }: MarkdownWorkbenchProps) {
+  const [mode, setMode] = useState<Mode>('preview')
+  const [revision, setRevision] = useState(0)
+  const [document, setDocument] = useState<MarkdownPreviewDocument | null>(null)
+  const [error, setError] = useState<string | null>(null)
+  const [loading, setLoading] = useState(true)
+  const [copied, setCopied] = useState(false)
+  const [draft, setDraft] = useState('')
+  const [saving, setSaving] = useState(false)
+  const paper: Paper = 'a4'
+  const orientation: Orientation = 'portrait'
+  const [plainText, setPlainText] = useState('')
+  const [wordSnapshot, setWordSnapshot] = useState<WordSnapshot | null>(null)
+
+  useEffect(() => {
+    onMetadata?.(document === null ? null : { bytes: document.bytes, modifiedAt: document.modifiedAt })
+    return () => { onMetadata?.(null) }
+  }, [document, onMetadata])
+
+  useEffect(() => {
+    const controller = new AbortController()
+    setLoading(true)
+    setError(null)
+    void load(path, controller.signal).then((result) => {
+      if (controller.signal.aborted) return
+      if (result.ok) {
+        setDocument(result.value.document)
+        setDraft(result.value.document.content)
+        try {
+          const key = wordStorageKey(path)
+          const stored = window.localStorage.getItem(key)
+            ?? window.localStorage.getItem(legacyWordStorageKey(path))
+          const parsed = stored === null ? null : JSON.parse(stored) as WordSnapshot
+          if (stored !== null && window.localStorage.getItem(key) === null) {
+            window.localStorage.setItem(key, stored)
+          }
+          setWordSnapshot(parsed?.source === result.value.document.content ? parsed : null)
+        } catch {
+          // Corrupt optional layout metadata cannot prevent the source file opening.
+          setWordSnapshot(null)
+        }
+      }
+      else setError(`${result.error.code}: ${safeErrorMessage(result.error.message, path)}`)
+    }).catch((reason: unknown) => {
+      if (!controller.signal.aborted) {
+        const message = reason instanceof Error ? reason.message : String(reason)
+        setError(safeErrorMessage(message, path))
+      }
+    }).finally(() => {
+      if (!controller.signal.aborted) setLoading(false)
+    })
+    return () => { controller.abort() }
+  }, [load, path, revision])
+
+  useEffect(() => { setMode('preview'); setDocument(null); setCopied(false) }, [path])
+  const dirty = document !== null && draft !== document.content
+  const copy = (): void => {
+    if (document === null) return
+    void navigator.clipboard.writeText(mode === 'plain' ? plainText : draft).then(() => {
+      setCopied(true)
+      window.setTimeout(() => { setCopied(false) }, 1500)
+    })
+  }
+  const download = (): void => {
+    if (document === null) return
+    const plain = mode === 'plain'
+    const url = URL.createObjectURL(new Blob([plain ? plainText : draft], {
+      type: plain ? 'text/plain;charset=utf-8' : 'text/markdown;charset=utf-8',
+    }))
+    const anchor = window.document.createElement('a')
+    anchor.href = url
+    const name = document.path.split('/').at(-1) ?? 'document.md'
+    anchor.download = plain ? name.replace(/\.(?:md|markdown)$/i, '.txt') : name
+    anchor.click()
+    window.setTimeout(() => { URL.revokeObjectURL(url) }, 0)
+  }
+  const saveDraft = (): void => {
+    if (document === null || !dirty || saving || save === undefined) return
+    const controller = new AbortController()
+    setSaving(true)
+    setError(null)
+    void save(path, draft, document.modifiedAt, controller.signal).then((result) => {
+      if (result.ok) {
+        setDocument(result.value.document)
+        setDraft(result.value.document.content)
+        setMode('preview')
+      } else setError(`${result.error.code}: ${safeErrorMessage(result.error.message, path)}`)
+    }).catch((reason: unknown) => {
+      const message = reason instanceof Error ? reason.message : String(reason)
+      setError(safeErrorMessage(message, path))
+    }).finally(() => { setSaving(false) })
+  }
+  const editWord = (markdown: string, pages: string[]): void => {
+    setDraft(markdown)
+    const next = { source: markdown, pages }
+    setWordSnapshot(next)
+    try { window.localStorage.setItem(wordStorageKey(path), JSON.stringify(next)) } catch {
+      // Storage denial leaves the editor usable for the current open document.
+    }
+  }
+
+  return <div className={css.root}>
+    <PlainTextProjection text={draft} onChange={setPlainText} />
+    <div className={css.nav}>
+      <div className={css.viewGroup}><div className={css.tabs} role="tablist" aria-label={t('file.views')}>
+        {(['plain', 'preview', 'word', 'pdf'] as const).map(id => <button
+          key={id} type="button" role="tab" aria-selected={id === 'preview' ? mode === 'preview' || mode === 'source' : mode === id}
+          className={css.tab} onClick={() => { setMode(id) }}
+        >{id === 'preview' ? t('file.markdownLayout')
+            : id === 'plain' ? t('file.plain')
+              : id === 'word' ? t('file.wordLayout') : t('file.pdfLayout')}</button>)}
+      </div>
+      {(mode === 'preview' || mode === 'source') && <button
+        type="button" className={css.subview}
+        onClick={() => { setMode(mode === 'preview' ? 'source' : 'preview') }}
+      >{mode === 'preview' ? t('file.sourceToggle') : t('file.previewToggle')}</button>}
+      </div>
+      <div className={css.actions}>
+        <button type="button" onClick={copy} disabled={document === null}>{copied ? t('file.copied') : t('file.copy')}</button>
+        <button type="button" onClick={saveDraft} disabled={!dirty || saving || save === undefined}>{saving ? t('file.saving') : t('file.save')}</button>
+        <button type="button" onClick={download} disabled={document === null}>{t('file.download')}</button>
+        <button type="button" onClick={() => { setRevision(value => value + 1) }}>{t('file.refresh')}</button>
+        <button type="button" onClick={() => { window.print() }}>{t('file.print')}</button>
+        <button type="button" onClick={() => { openExternal(path) }}>{t('file.external')}</button>
+      </div>
+    </div>
+    <div className={css.body} aria-live="polite" aria-busy={loading}>
+      {loading ? <div className={css.state}>{t('file.loading')}</div>
+        : error !== null ? <div className={css.error} role="alert">
+          <span>{t('file.error', { message: error })}</span>
+          <button type="button" onClick={() => { setRevision(value => value + 1) }}>{t('file.refresh')}</button>
+        </div>
+          : document === null ? null
+            : document.content === '' ? <div className={css.state}>{t('file.empty')}</div>
+              : mode === 'source' ? <textarea
+                className={css.source} value={draft} aria-label={t('file.editor')}
+                onChange={(event) => { setDraft(event.currentTarget.value) }}
+              />
+                : mode === 'plain' ? <pre className={css.plain}>{plainText}</pre>
+                  : mode === 'word' ? <div className={css.canvas} data-word-layout>
+                    <WordToolbar />
+                    <div className={css.layoutBadge}>{t('file.wordBadge')}</div>
+                    <PaginatedMarkdown
+                      text={draft} paper={paper} orientation={orientation}
+                      editable snapshot={wordSnapshot} onEdit={editWord}
+                    />
+                  </div>
+                    : mode === 'pdf' ? <div className={css.canvas} data-pdf-preview>
+                      <div className={css.pdfBadge}>{t('file.pdfBadge')}</div>
+                      <PaginatedMarkdown text={draft} paper={paper} orientation={orientation} snapshot={wordSnapshot} />
+                    </div>
+                      : <article className={css.preview}><MarkdownText text={draft} /></article>}
+    </div>
+  </div>
+}
