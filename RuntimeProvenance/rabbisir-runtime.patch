diff --git a/packages/client/ui-conversation/src/client/native-projection.ts b/packages/client/ui-conversation/src/client/native-projection.ts
new file mode 100644
index 0000000..48db0df
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/native-projection.ts
@@ -0,0 +1,545 @@
+import type {
+  AssistantBlock, ChatConversationViewNode, ChatSnapshot, ConversationSnapshot,
+  ISessions, SessionFace, ToolCallBlock, UserMessageNode,
+} from '@deepseek-ai/dsh-client-runtime/client'
+import type {
+  ComposerSubmitGesture, InputSubmitMode,
+} from './contract/composer-submission.ts'
+
+type ConversationContentBlock = UserMessageNode['content'][number]
+
+/** JSON-safe image metadata the native shell may resolve through the authenticated attachment API. */
+export interface NativeProjectionImage {
+  readonly attachmentId: string
+  readonly mediaType: string
+  readonly bytes: number
+  readonly width: number
+  readonly height: number
+  readonly name?: string
+}
+
+/** JSON-safe tool presentation derived exclusively from the official render-intent fields. */
+export interface NativeProjectionTool {
+  readonly title: string
+  readonly summary: string | null
+  readonly state: 'running' | 'succeeded' | 'failed' | 'stopped'
+}
+
+/** JSON-safe completed-turn metadata, including official deliverable locations. */
+export interface NativeProjectionTurnTail {
+  readonly durationMilliseconds: number | null
+  readonly firstTokenLatencyMilliseconds: number | null
+  readonly tokensPerSecond: number | null
+  readonly producedFiles: readonly string[]
+  readonly branchSequence: number | null
+  readonly isBranchUnavailable: boolean
+}
+
+/** One user-visible semantic row consumed by Rabbisir's replaceable native renderer. */
+export interface NativeConversationProjectionRow {
+  readonly id: string
+  readonly kind: 'user' | 'assistant' | 'reasoning' | 'image' | 'tool' | 'command'
+    | 'compaction' | 'notice' | 'error' | 'turn-tail'
+  readonly sequence: number
+  readonly text: string
+  readonly detail: string | null
+  readonly images: readonly NativeProjectionImage[]
+  readonly isStreaming: boolean
+  readonly turn: number | null
+  readonly time: number | null
+  readonly copyText: string | null
+  readonly tool: NativeProjectionTool | null
+  readonly turnTail: NativeProjectionTurnTail | null
+}
+
+/** Pure projection result for one official Chat snapshot. */
+export interface NativeConversationProjection {
+  readonly rows: readonly NativeConversationProjectionRow[]
+}
+
+/** Versioned current-session envelope exposed to the native host. */
+export interface NativeConversationProjectionEnvelope extends NativeConversationProjection {
+  readonly version: 1
+  readonly revision: number
+  readonly sessionId: string | null
+  readonly openState: string
+  readonly hasMore: boolean
+  readonly loadingOlder: boolean
+  readonly running: boolean
+}
+
+/** Native composer action whose delivery semantics remain owned by the official client. */
+export type NativeConversationSubmitGesture = ComposerSubmitGesture | 'button'
+
+/** Minimal result returned across the native semantic action boundary. */
+export interface NativeConversationSubmitResult {
+  readonly accepted: boolean
+  readonly action: 'prompt' | 'steer-queue' | 'none'
+  readonly mode: InputSubmitMode | null
+}
+
+/** Official keyboard policy resolver captured from the owning conversation plugin. */
+export type NativeConversationSubmitModeResolver = (
+  running: boolean,
+  gesture: ComposerSubmitGesture,
+  steeringAvailable: boolean,
+) => InputSubmitMode
+
+/** Browser-global read face. It exposes semantics and actions, never DOM or React values. */
+export interface NativeConversationProjectionReader {
+  read(afterRevision?: number): NativeConversationProjectionEnvelope | null
+  loadOlder(): Promise<void>
+  /** Return the official current SessionId without exposing the client store. */
+  currentSessionID(): string | null
+  /** Refresh and open one official session through the sessions service. */
+  openSession(sessionID: string): Promise<boolean>
+  /** Clear official current-session state, including its persisted selection. */
+  clearSelection(): void
+  /**
+   * Submit through the official session face and Host-backed keyboard policy.
+   * @param text - native composer text; empty text is meaningful only for accelerated queue steering.
+   * @param gesture - the native keyboard or button gesture that determines official delivery semantics.
+   * @returns the accepted official action without exposing session internals.
+   */
+  submit(text: string, gesture: NativeConversationSubmitGesture): Promise<NativeConversationSubmitResult>
+}
+
+declare global {
+  var __DSH_NATIVE_CONVERSATION_PROJECTION__: NativeConversationProjectionReader | undefined
+  var __DSH_NATIVE_CONVERSATION_PROJECTION_DID_CHANGE__:
+    ((value: NativeConversationProjectionEnvelope) => void) | undefined
+}
+
+function image(block: Extract<AssistantBlock, { kind: 'image' }>): NativeProjectionImage {
+  return {
+    attachmentId: String(block.attachment.attachmentId),
+    mediaType: block.attachment.mediaType,
+    bytes: block.attachment.bytes,
+    width: block.attachment.width,
+    height: block.attachment.height,
+    ...block.attachment.name === undefined ? {} : { name: block.attachment.name },
+  }
+}
+
+function contentText(content: readonly ConversationContentBlock[]): string {
+  return content.flatMap(block => block.type === 'text' ? [block.text] : []).join('\n')
+}
+
+function contentImages(content: readonly ConversationContentBlock[]): NativeProjectionImage[] {
+  return content.flatMap((block): NativeProjectionImage[] => block.type === 'image'
+    ? [image({ kind: 'image', attachment: block.attachment })]
+    : [])
+}
+
+function baseRow(
+  node: ChatConversationViewNode,
+  kind: NativeConversationProjectionRow['kind'],
+  text: string,
+  options: Partial<Omit<NativeConversationProjectionRow, 'kind' | 'text'>> = {},
+): NativeConversationProjectionRow {
+  return {
+    id: node.key,
+    kind,
+    sequence: node.anchorSeq,
+    text,
+    detail: null,
+    images: [],
+    isStreaming: false,
+    turn: node.location.kind === 'turn' || node.location.kind === 'step'
+      ? node.location.turn.turn
+      : null,
+    time: null,
+    copyText: null,
+    tool: null,
+    turnTail: null,
+    ...options,
+  }
+}
+
+function salientInput(value: unknown): string | null {
+  if (typeof value === 'string') return value
+  if (typeof value === 'number' || typeof value === 'boolean') return String(value)
+  return null
+}
+
+function finiteNumber(value: unknown): number | null {
+  return typeof value === 'number' && Number.isFinite(value) ? value : null
+}
+
+function jsonSafeEnvelope(
+  envelope: NativeConversationProjectionEnvelope,
+): NativeConversationProjectionEnvelope {
+  return JSON.parse(JSON.stringify(envelope)) as NativeConversationProjectionEnvelope
+}
+
+function toolTitle(root: ToolCallBlock): string {
+  if ('kind' in root && root.resultView?.title !== undefined) return root.resultView.title
+  if (root.callView?.title !== undefined) return root.callView.title
+  if ('kind' in root) return root.call?.name ?? root.callId
+  return root.name
+}
+
+function toolSummary(root: ToolCallBlock): string | null {
+  const view = root.callView
+  if (view === null) return null
+  if (view.card === 'terminal') return view.description ?? view.title
+  if (view.card === 'diff') return view.locations?.[0]?.path ?? view.diffs[0]?.path ?? null
+  return salientInput(view.rawInput) ?? view.locations?.[0]?.path ?? null
+}
+
+function toolDetail(root: ToolCallBlock): string | null {
+  if (!('kind' in root)) return null
+  const view = root.resultView
+  if (view === null) return contentText(root.content) || null
+  switch (view.card) {
+    case 'generic': return contentText(view.content ?? root.content) || null
+    case 'terminal': return view.output ?? null
+    case 'diff': return view.diffs.map(diff => diff.path).join('\n') || null
+    case 'read': return view.lines.map(line => `${line.number}\t${line.text}`).join('\n') || null
+    case 'search': return view.shape === 'paths'
+      ? view.paths.join('\n') || null
+      : view.files.flatMap(file => file.matches.map(match => `${file.path}:${match.lineNumber}: ${match.line}`))
+        .join('\n') || null
+    case 'web': return view.kind === 'fetch'
+      ? `${view.url}\nHTTP ${view.statusCode}`
+      : [view.answer, ...view.sources.map(source => source.title ?? source.url)].filter(Boolean).join('\n') || null
+    default: return null
+  }
+}
+
+function toolState(root: ToolCallBlock): NativeProjectionTool['state'] {
+  if (!('kind' in root)) return 'running'
+  if (!root.isError) return 'succeeded'
+  return root.error?.code === 'interrupted' ? 'stopped' : 'failed'
+}
+
+function toolRows(node: ChatConversationViewNode): NativeConversationProjectionRow[] {
+  const root = (node.data as { readonly root: ToolCallBlock }).root
+  const title = toolTitle(root)
+  return [baseRow(node, 'tool', title, {
+    detail: toolDetail(root),
+    time: root.time,
+    tool: { title, summary: toolSummary(root), state: toolState(root) },
+  })]
+}
+
+function assistantRows(node: ChatConversationViewNode): NativeConversationProjectionRow[] {
+  const data = node.data as {
+    readonly status: 'running' | 'settled' | 'interrupted'
+    readonly turn: number
+    readonly time: number
+    readonly blocks: readonly AssistantBlock[]
+  }
+  return data.blocks.flatMap((block, index): NativeConversationProjectionRow[] => {
+    const id = `${node.key}:${block.kind}:${index}`
+    if (block.kind === 'text' && block.text.trim() !== '') {
+      return [{ ...baseRow(node, 'assistant', block.text, {
+        id,
+        isStreaming: data.status === 'running',
+        turn: data.turn,
+        time: data.time,
+      }) }]
+    }
+    if (block.kind === 'reasoning' && block.text.trim() !== '') {
+      return [{ ...baseRow(node, 'reasoning', block.text, {
+        id,
+        detail: block.text,
+        isStreaming: data.status === 'running',
+        turn: data.turn,
+        time: data.time,
+      }) }]
+    }
+    if (block.kind === 'image') {
+      return [{ ...baseRow(node, 'image', block.attachment.name ?? '图片', {
+        id,
+        images: [image(block)],
+        isStreaming: data.status === 'running',
+        turn: data.turn,
+        time: data.time,
+      }) }]
+    }
+    return []
+  })
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null
+}
+
+function isProducedFile(value: unknown): value is { readonly seq: number; readonly path: string } {
+  return isRecord(value) && typeof value.seq === 'number' && typeof value.path === 'string'
+}
+
+function producedFiles(node: ChatConversationViewNode, closingSequence: number): readonly string[] {
+  if (node.location.kind !== 'turn' && node.location.kind !== 'step') return []
+  const locationData = node.location.turn.data as unknown as { get(key: string): unknown }
+  const data = locationData.get('deliverables')
+  if (!isRecord(data) || !Array.isArray(data.produced)) return []
+  const seen = new Set<string>()
+  const paths: string[] = []
+  for (const item of data.produced as unknown[]) {
+    if (!isProducedFile(item) || item.seq > closingSequence) continue
+    if (seen.has(item.path)) continue
+    seen.add(item.path)
+    paths.push(item.path)
+  }
+  return paths
+}
+
+function turnTailRow(node: ChatConversationViewNode): NativeConversationProjectionRow[] {
+  const data = node.data as {
+    readonly turn: number
+    readonly seq: number
+    readonly time: number
+    readonly closing: {
+      readonly blocks: readonly AssistantBlock[]
+      readonly finalNode: { readonly seq: number }
+    } | null
+    readonly branchUnavailable?: unknown
+    readonly ttftMs?: number
+    readonly tokensPerSecond?: number
+  }
+  const copyText = data.closing?.blocks
+    .flatMap(block => block.kind === 'text' ? [block.text] : [])
+    .join('\n') ?? null
+  const timing = node.location.kind === 'turn' || node.location.kind === 'step'
+    ? node.location.turn
+    : undefined
+  const duration = timing?.start === undefined || timing.end === undefined
+    ? null
+    : timing.end.time - timing.start.time
+  return [baseRow(node, 'turn-tail', '', {
+    sequence: data.closing?.finalNode.seq ?? data.seq,
+    time: data.time,
+    turn: data.turn,
+    copyText: copyText === '' ? null : copyText,
+    turnTail: {
+      durationMilliseconds: finiteNumber(duration),
+      firstTokenLatencyMilliseconds: finiteNumber(data.ttftMs),
+      tokensPerSecond: finiteNumber(data.tokensPerSecond),
+      producedFiles: producedFiles(node, data.closing?.finalNode.seq ?? data.seq),
+      branchSequence: data.closing?.finalNode.seq ?? null,
+      isBranchUnavailable: data.branchUnavailable === true,
+    },
+  })]
+}
+
+function messageRows(node: ChatConversationViewNode): NativeConversationProjectionRow[] {
+  const data = node.data as {
+    readonly kind: 'user' | 'steering'
+    readonly seq: number
+    readonly time: number
+    readonly source: unknown
+    readonly content: readonly ConversationContentBlock[]
+  }
+  const source = data.source as { readonly kind?: unknown }
+  if (source.kind !== 'user') return []
+  const text = contentText(data.content)
+  const images = contentImages(data.content)
+  if (text.trim() === '' && images.length === 0) return []
+  return [baseRow(node, 'user', text, {
+    time: data.time,
+    images,
+    copyText: text.trim() === '' ? null : text,
+  })]
+}
+
+function nonMessageRows(node: ChatConversationViewNode): NativeConversationProjectionRow[] {
+  switch (node.kind) {
+    case 'tool-call': return toolRows(node)
+    case 'assistant-step': return assistantRows(node)
+    case 'turn-tail': return turnTailRow(node)
+    case 'command': {
+      const data = node.data as {
+        readonly name: string | null
+        readonly args: string | null
+        readonly time: number
+        readonly outcome: { readonly kind: string; readonly text?: string } | null
+      }
+      const title = data.name === null ? '命令' : `/${data.name}`
+      return [baseRow(node, 'command', title, {
+        detail: data.outcome?.text ?? data.args,
+        time: data.time,
+        tool: { title, summary: data.args, state: data.outcome === null ? 'running' : data.outcome.kind === 'success' ? 'succeeded' : 'failed' },
+      })]
+    }
+    case 'manual-compaction':
+    case 'compaction': {
+      const data = node.kind === 'manual-compaction'
+        ? (node.data as { readonly compaction: { readonly summary: string | null; readonly time: number } | null }).compaction
+        : node.data as { readonly summary: string | null; readonly time: number }
+      if (data === null) return []
+      return [baseRow(node, 'compaction', '上下文已自动压缩', { detail: data.summary, time: data.time })]
+    }
+    case 'model-retry': {
+      const data = node.data as { readonly current: { readonly time: number; readonly delayMs?: number } }
+      return [baseRow(node, 'notice', '模型请求正在重试', { time: data.current.time })]
+    }
+    case 'turn-error': {
+      const data = node.data as { readonly message: string; readonly time: number; readonly turn: number }
+      return [baseRow(node, 'error', '本轮任务失败', { detail: data.message, time: data.time, turn: data.turn })]
+    }
+    case 'turn-max-tokens': {
+      const data = node.data as { readonly time: number; readonly turn: number }
+      return [baseRow(node, 'notice', '回复已达到本轮输出上限', { time: data.time, turn: data.turn })]
+    }
+    default: return []
+  }
+}
+
+/**
+ * Project the official client Chat model into Rabbisir's versioned, privacy-filtered native read model.
+ * @param snapshot - official current-session Chat snapshot.
+ * @returns JSON-safe visible rows in official Chat order.
+ */
+export function projectNativeConversation(snapshot: ChatSnapshot): NativeConversationProjection {
+  const rows = snapshot.order.flatMap((key): NativeConversationProjectionRow[] => {
+    const node = snapshot.nodes.get(key)
+    if (node === undefined || node.visibility !== 'visible') return []
+    if (node.kind === 'user' || node.kind === 'steering') return messageRows(node)
+    if (node.kind === 'context' || node.kind === 'unknown') return []
+    return nonMessageRows(node)
+  })
+  return { rows }
+}
+
+class NativeProjectionController implements NativeConversationProjectionReader {
+  private revision = 0
+  private envelope: NativeConversationProjectionEnvelope
+  private session: SessionFace | undefined
+  private disposeSession: (() => void) | undefined
+
+  constructor(
+    private readonly sessions: ISessions,
+    private readonly resolveSubmitMode: NativeConversationSubmitModeResolver,
+  ) {
+    this.envelope = this.build(undefined)
+  }
+
+  start(): () => void {
+    const disposeList = this.sessions.list.subscribe(() => { this.rebind() })
+    this.rebind()
+    return () => {
+      disposeList()
+      this.disposeSession?.()
+      this.disposeSession = undefined
+      this.session = undefined
+    }
+  }
+
+  read(afterRevision?: number): NativeConversationProjectionEnvelope | null {
+    return afterRevision === this.envelope.revision ? null : this.envelope
+  }
+
+  async loadOlder(): Promise<void> {
+    await this.session?.loadOlder()
+  }
+
+  currentSessionID(): string | null {
+    const current = this.sessions.list.getSnapshot().current
+    return current === undefined ? null : String(current)
+  }
+
+  async openSession(sessionID: string): Promise<boolean> {
+    let listedID = this.sessions.list.getSnapshot().ids.find(id => String(id) === sessionID)
+    if (listedID === undefined) {
+      await this.sessions.refresh()
+      listedID = this.sessions.list.getSnapshot().ids.find(id => String(id) === sessionID)
+    }
+    if (listedID === undefined) return false
+    this.sessions.open(listedID)
+    return true
+  }
+
+  clearSelection(): void {
+    this.sessions.clear()
+  }
+
+  async submit(
+    text: string,
+    gesture: NativeConversationSubmitGesture,
+  ): Promise<NativeConversationSubmitResult> {
+    const session = this.session
+    if (session === undefined) return { accepted: false, action: 'none', mode: null }
+    const snapshot = session.getSnapshot()
+    const steeringAvailable = snapshot.subagent === null
+    const content = text.trim()
+    if (content === '') {
+      if (gesture !== 'accelerated' || !snapshot.running || !steeringAvailable) {
+        return { accepted: false, action: 'none', mode: null }
+      }
+      const queued = snapshot.queue.filter(item => item.placement === 'queued')
+      if (queued.length === 0) return { accepted: false, action: 'none', mode: null }
+      for (const item of queued) {
+        const result = await session.updateQueue(item.id, { kind: 'steer' })
+        if (result.ok) continue
+        if (result.error.code === 'steer-unavailable' || result.error.code === 'queue-item-not-found') {
+          break
+        }
+        return { accepted: false, action: 'steer-queue', mode: 'steer' }
+      }
+      return { accepted: true, action: 'steer-queue', mode: 'steer' }
+    }
+    const mode = gesture === 'button'
+      ? 'queue'
+      : this.resolveSubmitMode(snapshot.running, gesture, steeringAvailable)
+    const result = await session.prompt([{ type: 'text', text: content }], mode)
+    return { accepted: result.ok, action: 'prompt', mode }
+  }
+
+  private rebind(): void {
+    const id = this.sessions.list.getSnapshot().current
+    const next = id === undefined ? undefined : this.sessions.binding(id)?.session
+    if (next === this.session) {
+      this.publish()
+      return
+    }
+    this.disposeSession?.()
+    this.session = next
+    this.disposeSession = next?.subscribe(() => { this.publish() })
+    this.publish()
+  }
+
+  private publish(): void {
+    this.revision++
+    this.envelope = this.build(this.session)
+    globalThis.__DSH_NATIVE_CONVERSATION_PROJECTION_DID_CHANGE__?.(this.envelope)
+  }
+
+  private build(session: SessionFace | undefined): NativeConversationProjectionEnvelope {
+    const snapshot: ConversationSnapshot | undefined = session?.getSnapshot()
+    const projection = snapshot === undefined ? { rows: [] } : projectNativeConversation(snapshot.chat)
+    const envelope: NativeConversationProjectionEnvelope = {
+      version: 1,
+      revision: this.revision,
+      sessionId: snapshot?.sessionId === undefined ? null : String(snapshot.sessionId),
+      openState: snapshot?.openState ?? 'idle',
+      hasMore: snapshot?.hasMore ?? false,
+      loadingOlder: snapshot?.loadingOlder ?? false,
+      running: snapshot?.running ?? false,
+      ...projection,
+    }
+    return jsonSafeEnvelope(envelope)
+  }
+}
+
+/**
+ * Install the replaceable native semantic projection face for the owning client fiber.
+ * @param sessions - official sessions service.
+ * @param resolveSubmitMode - live Host-backed keyboard policy resolver.
+ * @returns disposer removing subscriptions and the global face.
+ */
+export function installNativeConversationProjection(
+  sessions: ISessions,
+  resolveSubmitMode: NativeConversationSubmitModeResolver,
+): () => void {
+  const controller = new NativeProjectionController(sessions, resolveSubmitMode)
+  const dispose = controller.start()
+  globalThis.__DSH_NATIVE_CONVERSATION_PROJECTION__ = controller
+  return () => {
+    dispose()
+    if (globalThis.__DSH_NATIVE_CONVERSATION_PROJECTION__ === controller) {
+      globalThis.__DSH_NATIVE_CONVERSATION_PROJECTION__ = undefined
+    }
+  }
+}
