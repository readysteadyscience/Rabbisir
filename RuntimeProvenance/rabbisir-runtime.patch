@@ -0,0 +1,47 @@
+/** Persistent Session Header control for the mounted right workbench. */
+import type { PropsLocale } from '@deepseek-ai/dsh-client-ui-slots'
+import type { NS } from '../locales.ts'
+import css from './DetailsToggle.module.css'
+
+/** Callback injected by the layout service. */
+export interface DetailsToggleInjected {
+  /** Toggle the mounted details column between its default width and closed. */
+  toggleDetails: () => void
+}
+
+/** Props supplied by the header utility slot. */
+export type DetailsToggleProps = DetailsToggleInjected & PropsLocale<typeof NS>
+
+export type BrowserControlStatus = 'disconnected' | 'connected'
+
+/** Report whether Studio currently controls its reserved embedded browser surface. */
+export function BrowserControlEntry({ status = 'disconnected' }: { status?: BrowserControlStatus }) {
+  const labels: Record<BrowserControlStatus, string> = {
+    disconnected: '未连接', connected: '已连接',
+  }
+  const label = `浏览器控制：${labels[status]}`
+  return <button
+    type="button" className={css.browserControl} data-status={status}
+    aria-label={label} aria-disabled={status !== 'connected'} title={label}
+  >
+    <span>浏览器控制</span><i aria-hidden />
+  </button>
+}
+
+/** Toggle the right workbench without replacing its Session-owned content. */
+export function DetailsToggle({ toggleDetails, t }: DetailsToggleProps) {
+  return (
+    <button
+      type="button"
+      className={css.button}
+      aria-label={t('details.toggle')}
+      title={t('details.toggle')}
+      onClick={toggleDetails}
+    >
+      <svg viewBox="0 0 18 18" width="16" height="16" aria-hidden>
+        <rect x="2.25" y="2.75" width="13.5" height="12.5" rx="2" fill="none" stroke="currentColor" strokeWidth="1.4" />
+        <path d="M11.25 3.25v11.5" fill="none" stroke="currentColor" strokeWidth="1.4" />
+      </svg>
+    </button>
+  )
+}
